---
import { siteConfig } from "../config";
---

<section id="presentations" class="pres-section p-8 sm:p-12 md:p-16 lg:p-24">
  <div>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
      <div class="lg:col-span-4">
        <h2 class="text-3xl sm:text-4xl md:text-5xl xl:text-6xl font-bold pres-heading">
          Speaking
        </h2>
        <div
          class="w-[75px] h-[5px] mt-2 rounded-full"
          style={`background-color: ${siteConfig.accentColor}`}
        />
      </div>

      <div class="lg:col-span-8">
        <p class="pres-subtext text-base sm:text-lg leading-relaxed">
          17 conference presentations and seminars between 2010 and 2017, spanning implementation science, EHR optimization, primary care redesign, and patient engagement. Presented at AHRQ, AMIA-affiliated, and national primary care research venues.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .pres-section {
    background-color: #f9fafb;
  }
  :global([data-theme="dark"]) .pres-section {
    background-color: #111827;
  }

  .pres-heading {
    color: #111827;
  }
  :global([data-theme="dark"]) .pres-heading {
    color: #f9fafb;
  }

  .pres-title {
    color: #111827;
  }
  :global([data-theme="dark"]) .pres-title {
    color: #f9fafb;
  }

  .pres-subtext {
    color: #6b7280;
  }
  :global([data-theme="dark"]) .pres-subtext {
    color: #9ca3af;
  }
</style>
